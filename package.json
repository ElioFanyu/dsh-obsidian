{
  "name": "dsh-obsidian",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Connects a local Obsidian vault to DSH over MCP, with the obsidian-mcp server bundled in this package.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "server"
  ],
  "scripts": {
    "test": "node --test test/host.test.js",
    "doctor": "node server/node_modules/obsidian-mcp/dist/main.js doctor --vault main=D:/Workspace/Obsidian"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
